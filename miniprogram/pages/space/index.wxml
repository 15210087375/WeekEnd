<view class="page">
  <view class="card">
    <view class="mode-line">
      <text class="mode-tag {{inSpace ? 'space' : 'local'}}">{{inSpace ? '家庭空间' : '仅本机'}}</text>
      <text class="muted" wx:if="{{inSpace}}">{{spaceName}}</text>
    </view>
    <view class="hint" wx:if="{{!cloudConfigured}}">
      开发者尚未开通云环境时，只能使用本机数据与文件备份。
    </view>
    <view class="hint" wx:elif="{{!inSpace}}">
      默认仅本机。需要和家人共享菜单时，点下方创建或输入邀请码加入。日常记菜、心愿无需操作本页。
    </view>
    <view class="name-row" bindtap="onToggleNameEdit">
      <text class="muted">显示名</text>
      <text class="name-val">{{displayName || '用户'}}</text>
      <text class="link">改</text>
    </view>
    <view wx:if="{{showNameEdit}}" class="name-edit">
      <input
        class="form-input"
        placeholder="家人看到的名字"
        value="{{formDisplayName}}"
        bindinput="onNameInput"
      />
      <button class="btn-ghost btn-block" loading="{{busy}}" bindtap="onSaveName">保存昵称</button>
    </view>
  </view>

  <block wx:if="{{!inSpace}}">
    <view class="card">
      <view class="card-title">和家人一起用</view>
      <view class="hint">创建后你是主账号，自动生成「xx的家」。把邀请码发给家人即可。</view>
      <button
        class="btn-primary btn-block"
        loading="{{busy}}"
        disabled="{{!cloudConfigured}}"
        bindtap="onCreateFamily"
      >创建家庭</button>
    </view>

    <view class="card">
      <view class="card-title">加入已有家庭</view>
      <input
        class="form-input"
        placeholder="输入 6 位邀请码"
        value="{{formInvite}}"
        bindinput="onInviteInput"
      />
      <button
        class="btn-primary btn-block"
        loading="{{busy}}"
        disabled="{{!cloudConfigured}}"
        bindtap="onJoin"
      >加入</button>
    </view>
  </block>

  <block wx:else>
    <view class="card">
      <view class="card-title">空间信息</view>
      <view class="row-line">
        <text class="label">名称</text>
        <text>{{spaceName}}</text>
      </view>
      <view class="row-line">
        <text class="label">邀请码</text>
        <text class="code">{{inviteCode}}</text>
        <text class="link" bindtap="onCopyInvite">复制发给家人</text>
      </view>
      <view class="row-line">
        <text class="label">角色</text>
        <text>{{isOwner ? '主账号' : '成员'}}</text>
      </view>
      <button class="btn-ghost btn-block" loading="{{busy}}" bindtap="onRefresh">刷新成员</button>
    </view>

    <view class="card">
      <view class="card-title">成员（{{members.length}}/5）</view>
      <view class="member" wx:for="{{members}}" wx:key="userId">
        <view class="member-main">
          <text class="member-name">{{item.displayName}}</text>
          <text class="member-role">{{item.role === 'owner' ? '主账号' : '成员'}}</text>
        </view>
        <view class="member-actions" wx:if="{{isOwner && item.role !== 'owner'}}">
          <text
            class="link"
            data-id="{{item.userId}}"
            data-name="{{item.displayName}}"
            bindtap="onTransfer"
          >转让主号</text>
          <text
            class="link danger"
            data-id="{{item.userId}}"
            data-name="{{item.displayName}}"
            bindtap="onKick"
          >移出</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">空间操作</view>
      <button
        class="btn-ghost btn-block"
        loading="{{busy}}"
        bindtap="onLeave"
        wx:if="{{!isOwner}}"
      >退出空间</button>
      <view class="hint" wx:if="{{isOwner}}">主账号须先转让主号，或解散空间。</view>
      <button
        class="btn-danger btn-block"
        loading="{{busy}}"
        bindtap="onDissolve"
        wx:if="{{isOwner}}"
      >解散空间</button>
    </view>
  </block>

  <view class="card">
    <view class="card-title">本机存档</view>
    <view class="hint">可按菜单 / 点餐 / 心愿单分模块备份，与是否入空间无关。</view>
    <button class="btn-ghost btn-block" bindtap="goBackup">数据备份</button>
  </view>
</view>
