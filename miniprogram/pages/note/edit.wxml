<view class="container page-with-fab">
  <view class="card">
    <view class="form-item">
      <view class="form-label">标题</view>
      <input
        class="form-input"
        value="{{title}}"
        bindinput="onTitle"
        placeholder="不填则用正文开头"
        maxlength="80"
      />
    </view>

    <view class="form-item">
      <view class="form-label">正文 *</view>
      <textarea
        class="form-textarea"
        value="{{body}}"
        bindinput="onBody"
        placeholder="随手记下想法、链接、清单"
        maxlength="4000"
        auto-height
      />
    </view>

    <view class="form-item">
      <view class="form-label">日期</view>
      <picker
        mode="multiSelector"
        range="{{dateRange}}"
        value="{{dateIndex}}"
        bindchange="onDatePick"
        bindcolumnchange="onDateColumn"
      >
        <view class="form-input form-input-tap">
          <text class="{{dateText ? '' : 'ph'}}">{{dateText || '选日期'}}</text>
          <text class="caret">›</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">标签</view>
      <view class="chip-row">
        <view
          class="chip {{tag === item.id ? 'active' : ''}}"
          wx:for="{{tags}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPickTag"
        >{{item.name}}</view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">可见范围</view>
      <view class="chip-row">
        <view
          class="chip {{visibility === 'private' ? 'active' : ''}}"
          data-id="private"
          bindtap="onPickVisibility"
        >仅自己</view>
        <view
          class="chip {{visibility === 'space' ? 'active' : ''}}"
          data-id="space"
          bindtap="onPickVisibility"
        >家人可见</view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">图片</view>
      <view class="img-row">
        <view class="img-item" wx:for="{{images}}" wx:key="localPath">
          <image class="img" src="{{item.localPath}}" mode="aspectFill" />
          <view class="img-del" data-index="{{index}}" bindtap="onRemoveImage">×</view>
        </view>
        <view class="img-add" bindtap="onAddImage" wx:if="{{images.length < 6}}">+</view>
      </view>
    </view>
  </view>

  <button class="btn-danger btn-block" wx:if="{{id}}" bindtap="onDelete">删除这条</button>
</view>

<view class="fab-bar {{fabReady ? 'fab-ready' : ''}}">
  <button class="btn-primary" bindtap="onSave">保存</button>
</view>
