.img-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.img-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.img-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.img-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
  border: 2rpx dashed #ccc;
  color: #999;
  font-size: 56rpx;
  line-height: 160rpx;
  text-align: center;
}

.chip.active {
  background: #eef0ff;
  color: #5b6cff;
}

.form-input-tap {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-input-tap .ph {
  color: #bbb;
}

.form-input-tap .caret {
  color: #ccc;
  font-size: 28rpx;
  margin-left: 8rpx;
}
