.mode-tip {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.tag-orange {
  background: #fff3e8;
  color: #ff8f1f;
}

.btn-home {
  background: #ff8f1f !important;
}

.img-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}


.thumb-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #eee;
}

.thumb-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  text-align: center;
  line-height: 40rpx;
  font-size: 28rpx;
}

.thumb-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #ccc;
  color: #999;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
