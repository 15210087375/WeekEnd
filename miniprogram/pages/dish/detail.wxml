<view class="container page-with-fab" wx:if="{{dish}}">
  <view class="card">
    <view class="mode-tip {{isRecipe ? 'tip-home' : 'tip-out'}}">{{kindLabel}}</view>
    <view class="row">
      <view class="card-title" style="margin:0;">{{dish.name}}</view>
      <text class="score" wx:if="{{dish.score != null}}">{{dish.score}} 分</text>
    </view>
    <view class="muted" style="margin-top:8rpx;" wx:if="{{!isRecipe}}">{{dish.placeLabel}}</view>
    <view style="margin-top:12rpx;">
      <text class="tag tag-green" wx:if="{{categoryLabel}}">{{categoryLabel}}</text>
      <text class="tag tag-orange" wx:if="{{!isRecipe && spicyLabel}}">{{spicyLabel}}</text>
      <text class="tag" wx:if="{{!isRecipe}}" wx:for="{{dish.tasteTags}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="muted" style="margin-top:12rpx;" wx:if="{{dish.note}}">{{dish.note}}</view>
  </view>

  <view class="card" wx:if="{{dish.images.length}}">
    <view class="card-title">{{isRecipe ? '成品照片' : '照片'}}</view>
    <view class="img-row">
      <image
        wx:for="{{dish.images}}"
        wx:key="localPath"
        src="{{item.localPath}}"
        mode="aspectFill"
        class="thumb"
        data-url="{{item.localPath}}"
        bindtap="preview"
      />
    </view>
  </view>

  <view class="card" wx:if="{{isRecipe}}">
    <view class="card-title">用料</view>
    <view wx:if="{{dish.ingredients.length}}">
      <view wx:for="{{dish.ingredients}}" wx:key="*this">· {{item}}</view>
    </view>
    <view class="muted" wx:else>未填写</view>

    <view class="card-title" style="margin-top:20rpx;">步骤</view>
    <view wx:if="{{dish.steps.length}}">
      <view wx:for="{{dish.steps}}" wx:key="*this" style="margin-bottom:8rpx;">{{index + 1}}. {{item}}</view>
    </view>
    <view class="muted" wx:else>未填写</view>

    <view wx:if="{{hasDouyinShare}}" style="margin-top:16rpx;">
      <view class="card-title">抖音视频</view>
      <view class="muted">已保存完整分享口令（点下方按钮复制后去抖音打开）</view>
      <button
        class="btn-ghost btn-block"
        bindtap="copyDouyin"
      >{{douyinBtnLabel}}</button>
    </view>
  </view>
</view>

<view class="fab-bar" wx:if="{{dish}}">
  <button class="btn-danger" bindtap="onDelete">删除</button>
  <button class="btn-primary {{isRecipe ? 'btn-home' : ''}}" bindtap="onEdit">编辑</button>
</view>
