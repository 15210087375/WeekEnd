.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.chip.active {
  background: #eef0ff;
  color: #5b6cff;
}

.img-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.img-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.img-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.img-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
  border: 2rpx dashed #ccc;
  color: #5b6cff;
  font-size: 26rpx;
  line-height: 160rpx;
  text-align: center;
}

.form-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.btn-ghost {
  margin-top: 8rpx;
}
