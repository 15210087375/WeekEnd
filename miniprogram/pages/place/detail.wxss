.place-shell {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f5f5;
}

.place-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.place-shell > .fab-bar {
  position: relative;
  left: auto;
  right: auto;
  bottom: auto;
  flex-shrink: 0;
}

.container {
  padding-bottom: 24rpx;
}
