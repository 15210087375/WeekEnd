<view class="page">
  <view class="card">
    <view class="card-title">选择存档模块</view>
    <view class="mod-row" bindtap="onToggleAll">
      <view class="mod-check {{selectAll ? 'on' : ''}}">{{selectAll ? '✓' : ''}}</view>
      <view class="mod-body">
        <view class="mod-name">全部</view>
        <view class="mod-desc">菜单 + 点餐 + 心愿单</view>
      </view>
    </view>
    <view
      class="mod-row"
      wx:for="{{moduleOptions}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onToggleModule"
    >
      <view class="mod-check {{item.checked ? 'on' : ''}}">{{item.checked ? '✓' : ''}}</view>
      <view class="mod-body">
        <view class="mod-name">{{item.name}}</view>
        <view class="mod-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">导出备份文件</view>
    <button class="btn-primary btn-block" loading="{{exporting}}" bindtap="onExportFile">
      导出并分享文件
    </button>
    <button class="btn-ghost btn-block" loading="{{exporting}}" bindtap="onExportOpen">
      导出并打开文件
    </button>
    <view class="meta muted" wx:if="{{lastExportName}}">
      最近导出：{{lastExportName}}（{{lastExportSize}}）
      <text wx:if="{{lastExportModules}}"> · {{lastExportModules}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">导入备份文件</view>
    <button class="btn-primary btn-block" loading="{{importing}}" bindtap="onImportFile">
      选择文件导入
    </button>
  </view>

  <view class="card">
    <view class="card-title">剪贴板</view>
    <button class="btn-ghost btn-block" bindtap="onExportClip">复制到剪贴板</button>
    <button class="btn-ghost btn-block" bindtap="onImportClip">从剪贴板导入</button>
  </view>
</view>
