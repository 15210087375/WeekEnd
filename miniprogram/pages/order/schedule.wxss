.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

.date-pick {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 22rpx 20rpx;
  font-size: 30rpx;
  color: #1a1a1a;
}

.arrow {
  color: #ccc;
  font-size: 36rpx;
}

.slot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.slot-chip {
  min-width: 140rpx;
  text-align: center;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.slot-chip.on {
  background: #e8f8ef;
  color: #07c160;
  border-color: #07c160;
  font-weight: 600;
}

.preview {
  padding: 8rpx 8rpx 0;
  font-size: 24rpx;
  color: #999;
}

.fab-bar .btn-primary {
  width: 100%;
}
