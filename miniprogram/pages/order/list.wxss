.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f7f7;
  box-sizing: border-box;
}

.filter-bar {
  white-space: nowrap;
  margin-bottom: 16rpx;
  width: 100%;
}

.fchip {
  display: inline-block;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #666;
  font-size: 24rpx;
  border: 1rpx solid #eee;
}

.fchip.on {
  background: #e8f8ef;
  color: #07c160;
  border-color: #b7eb8f;
  font-weight: 600;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}

.card:active {
  background: #fafafa;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}

.status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #f0f0f0;
  color: #666;
}

.status-preorder {
  background: #eef0ff;
  color: #5b6cff;
}

.status-cooking {
  background: #fff3e8;
  color: #ff8f1f;
}

.status-dined {
  background: #e8f8ef;
  color: #07c160;
}

.status-abandoned {
  background: #f5f5f5;
  color: #999;
}

.muted {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 40rpx;
  font-size: 28rpx;
  line-height: 1.7;
}
