.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 48rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  flex: 1;
}

.status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  color: #666;
}

.status-preorder {
  background: #eef0ff;
  color: #5b6cff;
}

.status-cooking {
  background: #fff3e8;
  color: #ff8f1f;
}

.status-dined {
  background: #e8f8ef;
  color: #07c160;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-head .card-title {
  margin-bottom: 0;
}

.link {
  color: #07c160;
  font-size: 26rpx;
}

.mat-sec {
  margin-bottom: 12rpx;
}

.mat-sec:last-of-type {
  margin-bottom: 0;
}

.mat-sec__title {
  font-size: 24rpx;
  color: #888;
  font-weight: 600;
  margin: 8rpx 0 4rpx;
}

.dish-line,
.mat-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 28rpx;
}

.dish-line:last-child,
.mat-line:last-child {
  border-bottom: none;
}

.dish-name,
.mat-name {
  color: #1a1a1a;
  flex: 1;
}

.mat-count {
  color: #07c160;
  font-weight: 600;
}

.muted {
  color: #999;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.sub {
  margin-top: 16rpx;
  line-height: 1.5;
}

.actions {
  margin-top: 12rpx;
}

.actions .btn-block {
  margin-bottom: 16rpx;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
}
