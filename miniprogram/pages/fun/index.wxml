<view class="page">
  <view class="hero">
    <view class="hero-title">娱乐</view>
    <view class="hero-desc">心愿、购物、影院等生活记录</view>
  </view>
  <view class="entry-list">
    <view
      class="entry-card {{item.ready ? '' : 'entry-card-soon'}}"
      wx:for="{{modules}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-ready="{{item.ready}}"
      bindtap="onOpen"
    >
      <view class="entry-title">{{item.title}}</view>
      <view class="entry-desc">{{item.desc}}</view>
      <view class="entry-badge" wx:if="{{item.ready}}">可用</view>
      <view class="entry-badge soon" wx:else>即将推出</view>
    </view>
  </view>
</view>
