<app-nav-bar
  title="{{navTitle}}"
  show-back="{{showBack}}"
  fixed
  bind:back="popFunLayer"
  bind:ready="onNavReady"
/>
<scroll-view class="fun-body" scroll-y style="top: {{navTotal}}px;">
  <view class="entry-list">
    <view
      class="entry-card {{item.ready ? '' : 'entry-card-soon'}}"
      wx:for="{{modules}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-ready="{{item.ready}}"
      bindtap="onOpen"
    >
      <view class="entry-icon-wrap">
        <image class="entry-icon" src="{{item.icon}}" mode="aspectFit" />
      </view>
      <view class="entry-main">
        <view class="entry-title">{{item.title}}</view>
        <view class="entry-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
      </view>
      <view class="entry-arrow">›</view>
      <view class="entry-badge soon" wx:if="{{!item.ready}}">即将推出</view>
    </view>
  </view>
</scroll-view>
<app-tab-bar selected="{{1}}" />

<view
  class="fun-layer {{item.inn ? 'in' : ''}}"
  wx:for="{{layers}}"
  wx:key="key"
  style="z-index: {{200 + index}}; top: {{navTotal}}px;"
>
  <view class="fun-layer-body">
    <watch-home
      wx:if="{{item.name === 'watch'}}"
      id="watchHome"
      tab="{{item.params.tab}}"
    />
    <watch-plan
      wx:elif="{{item.name === 'watchPlan'}}"
      plan-id="{{item.params.id}}"
      preset-date="{{item.params.date}}"
    />
    <watch-record
      wx:elif="{{item.name === 'watchRecord'}}"
      record-id="{{item.params.id}}"
      from-plan-id="{{item.params.planId}}"
    />
    <cinema-detail
      wx:elif="{{item.name === 'cinemaDetail'}}"
      id="cinemaDetail"
      cinema-id="{{item.params.id}}"
    />
    <cinema-edit
      wx:elif="{{item.name === 'cinemaEdit'}}"
      cinema-id="{{item.params.id}}"
    />
    <cinema-hall
      wx:elif="{{item.name === 'cinemaHall'}}"
      hall-id="{{item.params.id}}"
      cinema-id="{{item.params.cinemaId}}"
    />
  </view>
</view>
