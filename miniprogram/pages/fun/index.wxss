.fun-body {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  padding: 24rpx;
  box-sizing: border-box;
  background: #f7f7f7;
}
.hero { background: #fff; border-radius: 20rpx; padding: 32rpx 28rpx; margin-bottom: 20rpx; border: 2rpx solid #eef0ff; }
.hero-title { font-size: 40rpx; font-weight: 700; color: #5b6cff; margin-bottom: 8rpx; }
.hero-desc { font-size: 26rpx; color: #888; }
.entry-list { display: flex; flex-direction: column; }
.entry-card {
  position: relative;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.entry-card-soon { opacity: 0.92; }
.entry-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #f6f7fb;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
  overflow: hidden;
}
.entry-icon { width: 80rpx; height: 80rpx; }
.entry-main { flex: 1; min-width: 0; }
.entry-title { font-size: 32rpx; font-weight: 600; color: #1a1a1a; }
.entry-desc { margin-top: 6rpx; font-size: 24rpx; color: #888; }
.entry-arrow {
  font-size: 44rpx;
  color: #ccc;
  font-weight: 300;
  padding-left: 12rpx;
}
.entry-card:active { background: #fafafa; }
.entry-badge { position: absolute; top: 24rpx; right: 24rpx; font-size: 20rpx; color: #07c160; background: #e8f8ef; padding: 4rpx 12rpx; border-radius: 8rpx; }
.entry-badge.soon { color: #5b6cff; background: #eef0ff; }
.muted { color: #999; }

.fun-layer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: #f7f7f7;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.28s ease-out;
}

.fun-layer.in {
  transform: translateX(0);
}

.fun-layer-body {
  flex: 1;
  min-height: 0;
  height: 0;
  position: relative;
}
