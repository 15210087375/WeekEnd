.page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; background: #f7f7f7; }
.hero { background: #fff; border-radius: 20rpx; padding: 32rpx 28rpx; margin-bottom: 20rpx; border: 2rpx solid #eef0ff; }
.hero-title { font-size: 40rpx; font-weight: 700; color: #5b6cff; margin-bottom: 8rpx; }
.hero-desc { font-size: 26rpx; color: #888; }
.entry-card { position: relative; background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 16rpx; }
.entry-card-soon { opacity: 0.92; }
.entry-title { font-size: 32rpx; font-weight: 600; color: #1a1a1a; margin-bottom: 8rpx; }
.entry-desc { font-size: 24rpx; color: #888; line-height: 1.4; padding-right: 120rpx; }
.entry-card:active { background: #fafafa; }
.entry-badge { position: absolute; top: 24rpx; right: 24rpx; font-size: 20rpx; color: #07c160; background: #e8f8ef; padding: 4rpx 12rpx; border-radius: 8rpx; }
.entry-badge.soon { color: #5b6cff; background: #eef0ff; }
.muted { color: #999; }
