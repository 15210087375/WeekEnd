<view class="container page-with-fab">
  <view class="card">
    <view class="form-item">
      <view class="form-label">标题 *</view>
      <input
        class="form-input"
        value="{{title}}"
        bindinput="onTitle"
        placeholder="如：公路自行车 / 羽绒服 / 北海道"
        maxlength="80"
      />
    </view>

    <view class="form-item">
      <view class="form-label">分类</view>
      <view class="chip-row">
        <view
          class="chip {{category === item.name ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          data-name="{{item.name}}"
          bindtap="onPickCategory"
        >{{item.name}}</view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">状态</view>
      <view class="chip-row">
        <view
          class="chip {{status === item.id ? 'active' : ''}}"
          wx:for="{{statusOptions}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPickStatus"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">可见范围</view>
      <view class="chip-row">
        <view
          class="chip {{visibility === 'space' ? 'active' : ''}}"
          data-id="space"
          bindtap="onPickVisibility"
        >家人可见</view>
        <view
          class="chip {{visibility === 'private' ? 'active' : ''}}"
          data-id="private"
          bindtap="onPickVisibility"
        >仅自己</view>
      </view>
      <view class="form-tip muted">仅自己：本地仅自己看；上云后他人与主号均不可读。</view>
    </view>

    <view class="form-item">
      <view class="form-label">参考价（可选）</view>
      <input
        class="form-input"
        type="digit"
        value="{{priceText}}"
        bindinput="onPrice"
        placeholder="如：2999"
      />
    </view>

    <view class="form-item">
      <view class="form-label">备注</view>
      <textarea
        class="form-textarea"
        value="{{note}}"
        bindinput="onNote"
        placeholder="尺码、型号、链接、预算等"
        maxlength="1000"
        auto-height
      />
    </view>

    <view class="form-item">
      <view class="form-label">图片</view>
      <view class="img-row">
        <view class="img-item" wx:for="{{images}}" wx:key="localPath">
          <image class="img" src="{{item.localPath}}" mode="aspectFill" />
          <view class="img-del" data-index="{{index}}" bindtap="onRemoveImage">×</view>
        </view>
        <view class="img-add" bindtap="onAddImage" wx:if="{{images.length < 6}}">+</view>
      </view>
    </view>
  </view>

  <button class="btn-danger btn-block" wx:if="{{id}}" bindtap="onDelete">删除心愿</button>
</view>

<view class="fab-bar">
  <button class="btn-primary" bindtap="onSave">保存</button>
</view>
