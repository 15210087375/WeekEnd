.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f7f7;
  box-sizing: border-box;
}

.filter-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
  width: 100%;
}

.filter-chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #666;
  font-size: 24rpx;
  border: 1rpx solid #eee;
}

.filter-chip.active {
  background: #eef0ff;
  color: #5b6cff;
  border-color: #cfd4ff;
  font-weight: 600;
}

.wish-card {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.wish-card:active {
  background: #fafafa;
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.body {
  flex: 1;
  min-width: 0;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
}

.status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #f0f0f0;
  color: #666;
}

.status-want {
  background: #eef0ff;
  color: #5b6cff;
}

.status-doing {
  background: #fff3e8;
  color: #ff8f1f;
}

.status-done {
  background: #e8f8ef;
  color: #07c160;
}

.status-drop {
  background: #f5f5f5;
  color: #999;
}

.meta {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
}

.tag {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #666;
}

.tag.private {
  background: #fff3e8;
  color: #ff8f1f;
}

.price {
  font-size: 24rpx;
  color: #ff8f1f;
  font-weight: 600;
}

.muted {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.time {
  -webkit-line-clamp: 1;
}

.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 40rpx;
  font-size: 28rpx;
  line-height: 1.7;
}
