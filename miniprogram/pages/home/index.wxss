.page-home {
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.order-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #e8f8ef;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.12);
}

.order-bar:active {
  background: #f7fcf9;
}

.order-bar__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #07c160;
  margin-bottom: 6rpx;
}

.order-bar__desc {
  font-size: 24rpx;
  color: #888;
}

.order-bar__go {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #07c160;
  padding-left: 16rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.entry-card:active {
  opacity: 0.92;
}

.entry-out {
  border: 2rpx solid #e8f8ef;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.1);
}

.entry-home {
  border: 2rpx solid #fff3e8;
  box-shadow: 0 4rpx 16rpx rgba(255, 143, 31, 0.1);
}

.entry-main {
  flex: 1;
}

.entry-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.entry-title-out {
  color: #07c160;
}

.entry-title-home {
  color: #ff8f1f;
}

.entry-meta {
  margin-top: 16rpx;
}

.entry-arrow {
  font-size: 48rpx;
  padding-left: 16rpx;
  font-weight: 300;
}

.entry-arrow-out {
  color: #07c160;
}

.entry-arrow-home {
  color: #ff8f1f;
}

/* —— 当前点餐 FAB（左下） —— */
.cart-fab {
  position: fixed;
  left: 28rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 50;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #07c160;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cart-fab:active {
  opacity: 0.9;
  transform: scale(0.96);
}

.cart-fab__icon {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.1;
}

.cart-fab__label {
  font-size: 18rpx;
  opacity: 0.95;
  margin-top: 2rpx;
}

.cart-badge {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #fa5151;
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  font-weight: 600;
}

/* —— 半屏面板 —— */
.cart-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 60;
}

.cart-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 70;
  max-height: 70vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 0 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  transform: translateY(110%);
  transition: transform 0.28s cubic-bezier(0.25, 0.8, 0.25, 1);
  pointer-events: none;
  overflow: hidden;
}

.cart-sheet--on {
  transform: translateY(0);
  pointer-events: auto;
}

/* 拖拽跟手时关闭过渡，避免粘滞 */
.cart-sheet--drag {
  transition: none;
}

/* 固定命中区，防止 setData / 文案显隐导致顶部空白乱闪 */
.cart-sheet__grab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 12rpx 48rpx 4rpx;
  margin: 0 -12rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  min-height: 56rpx;
}

.cart-sheet__pull-spacer {
  width: 100%;
  flex-shrink: 0;
  pointer-events: none;
}

.cart-sheet__handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #d8d8d8;
  flex-shrink: 0;
}

.cart-sheet__handle--active {
  width: 88rpx;
  background: #07c160;
}

.cart-sheet__pull-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 28rpx;
  height: 28rpx;
  min-height: 28rpx;
  text-align: center;
  opacity: 0.9;
}

.cart-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.cart-sheet__title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.cart-sheet__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.share-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #e8f8ef;
  color: #07c160;
  flex-shrink: 0;
}

.share-tag.local {
  background: #f0f0f0;
  color: #999;
}

.preorder-bar {
  white-space: nowrap;
  margin-bottom: 12rpx;
  width: 100%;
}

.preorder-chip {
  display: inline-block;
  padding: 10rpx 20rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 22rpx;
  border: 1rpx solid #eee;
}

.preorder-chip.on {
  background: #e8f8ef;
  color: #07c160;
  border-color: #b7eb8f;
  font-weight: 600;
}

.preorder-chip.add {
  background: #fff;
  color: #07c160;
  border: 1rpx dashed #07c160;
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 12rpx;
  font-size: 26rpx;
}

.date-label {
  color: #999;
}

.date-value {
  color: #1a1a1a;
  font-weight: 500;
}

.cart-sheet__actions {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.cart-link {
  font-size: 26rpx;
  color: #666;
}

.cart-link.muted {
  color: #999;
}

.cart-sheet__hint {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.cart-sheet__list {
  flex: 1;
  max-height: 42vh;
  min-height: 120rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.cart-item__main {
  flex: 1;
  min-width: 0;
}

.cart-item__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.cart-item__meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.cart-item__del {
  font-size: 26rpx;
  color: #fa5151;
  padding: 12rpx;
  flex-shrink: 0;
}

.cart-empty {
  text-align: center;
  padding: 48rpx 24rpx 32rpx;
  color: #666;
  font-size: 28rpx;
}

.cart-empty__sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.cart-empty__btn {
  margin-top: 28rpx;
  width: 60%;
}

.cart-sheet__foot {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 8rpx;
}

.cart-foot-row {
  display: flex;
  gap: 12rpx;
  width: 100%;
}

.cart-foot-btn {
  flex: 1;
  margin: 0 !important;
  font-size: 26rpx !important;
  padding: 16rpx 8rpx !important;
  line-height: 1.3 !important;
}

.cart-foot-btn--main {
  flex: 1.2;
}

.cart-foot-btn--danger {
  color: #fa5151 !important;
  border-color: #fa5151 !important;
}
