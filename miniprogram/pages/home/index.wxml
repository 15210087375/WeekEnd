<app-nav-bar title="美食" />
<view class="container page-home">
  <view class="home-search" bindtap="goFind">
    <text class="home-search-icon">⌕</text>
    <text class="home-search-ph">搜索菜名 / 门店 / 菜谱</text>
  </view>
  <stack-swiper
    list="{{entries}}"
    direction="horizontal"
    height="560rpx"
    bind:itemtap="onStackTap"
  />
</view>

<view
  wx:if="{{fabInited}}"
  class="cart-fab {{fabDragging ? 'dragging' : 'snap'}}"
  style="left: {{fabX}}px; top: {{fabY}}px;"
  catchtouchstart="onFabStart"
  catchtouchmove="onFabMove"
  catchtouchend="onFabEnd"
  catchtouchcancel="onFabEnd"
>
  <view class="cart-fab__icon">点</view>
  <view class="cart-fab__label">当前点餐</view>
  <view class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount > 99 ? '99+' : cartCount}}</view>
</view>

<cart-sheet id="cartSheet" bind:countchange="onCartCount" />
<app-tab-bar selected="{{0}}" />
