<view class="container page-home">
  <view
    class="entry-card entry-{{item.theme}}"
    wx:for="{{entries}}"
    wx:key="kind"
    data-kind="{{item.kind}}"
    bindtap="onEntryTap"
  >
    <view class="entry-main">
      <view class="entry-title entry-title-{{item.theme}}">{{item.name}}</view>
      <view class="muted">{{item.desc}}</view>
      <view class="entry-meta">
        <text class="tag {{item.theme==='home'?'tag-orange':'tag-green'}}">{{item.count}} 条</text>
      </view>
    </view>
    <view class="entry-arrow entry-arrow-{{item.theme}}">›</view>
  </view>
</view>

<view class="cart-fab" bindtap="openCart">
  <view class="cart-fab__icon">点</view>
  <view class="cart-fab__label">当前点餐</view>
  <view class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount > 99 ? '99+' : cartCount}}</view>
</view>

<cart-sheet id="cartSheet" bind:countchange="onCartCount" />
<app-tab-bar selected="{{0}}" />
