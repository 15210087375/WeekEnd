.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f7f7;
  box-sizing: border-box;
}

.cinema-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.cinema-card:active {
  background: #fafafa;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
}

.count {
  font-size: 22rpx;
  color: #5b6cff;
  background: #eef0ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.muted {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 40rpx;
  font-size: 28rpx;
  line-height: 1.7;
}
