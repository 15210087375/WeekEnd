<view class="page">
  <view class="space-card" bindtap="goSpace">
    <view class="space-left">
      <view class="space-top">
        <text class="space-tag {{spaceTagType}}">{{spaceTagText}}</text>
        <text class="space-title">{{spaceTitle}}</text>
      </view>
      <view class="space-sub">{{spaceSubtitle}}</view>
    </view>
    <text class="menu-arrow">›</text>
  </view>

  <view class="menu-group">
    <view class="menu-row" wx:if="{{canSync}}" bindtap="onSyncFamily">
      <text class="menu-label">同步家庭数据</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goOrders">
      <text class="menu-label">往期点餐</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goHistory">
      <text class="menu-label">历史记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goRegion">
      <text class="menu-label">管理区域</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goBackup">
      <text class="menu-label">数据备份</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row menu-row--last" bindtap="onLoadTestDishes">
      <text class="menu-label">加载测试家常菜</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
<app-tab-bar selected="{{3}}" />
