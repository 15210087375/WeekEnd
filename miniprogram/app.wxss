page {
  background: #f5f5f5;
  color: #191919;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.muted {
  color: #888;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-start {
  display: flex;
  align-items: center;
}

.gap-8 {
  gap: 8rpx;
}

.gap-16 {
  gap: 16rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 22rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}

.tag-green {
  background: #e8f8ef;
  color: #07c160;
}

.tag-orange {
  background: #fff3e8;
  color: #ff8f1f;
}

.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 16rpx 28rpx;
  border: none;
  line-height: 1.4;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: #fff;
  color: #07c160;
  border: 1rpx solid #07c160;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 14rpx 24rpx;
  line-height: 1.4;
}

.btn-ghost::after {
  border: none;
}

.btn-danger {
  background: #fff;
  color: #fa5151;
  border: 1rpx solid #fa5151;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 14rpx 24rpx;
  line-height: 1.4;
}

.btn-danger::after {
  border: none;
}

.btn-block {
  width: 100%;
  text-align: center;
  margin-top: 16rpx;
}

.fab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  display: flex;
  gap: 16rpx;
  z-index: 20;
}

.fab-bar .btn-primary,
.fab-bar .btn-ghost {
  flex: 1;
}

.list-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.list-item:active {
  background: #fafafa;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 24rpx;
  font-size: 28rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.form-input {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.form-textarea {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  min-height: 140rpx;
  width: 100%;
  box-sizing: border-box;
}

.seg {
  display: flex;
  background: #eee;
  border-radius: 12rpx;
  padding: 4rpx;
  margin-bottom: 20rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #666;
}

.seg-item.active {
  background: #fff;
  color: #07c160;
  font-weight: 600;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 24rpx;
}

.chip.active {
  background: #e8f8ef;
  color: #07c160;
}

.score {
  color: #ff8f1f;
  font-weight: 600;
}

.page-with-fab {
  padding-bottom: 160rpx;
}
