.stack {
  width: 100%;
}

.stage {
  position: relative;
  width: 100%;
  overflow: visible;
}

.layer {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  will-change: transform, opacity;
}

.horizontal .layer {
  transform-origin: left center;
}

.vertical .layer {
  transform-origin: top center;
}

.card {
  height: 100%;
  border-radius: 28rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

.card-horizontal {
  display: flex;
  flex-direction: column;
}

.card-vertical {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 8rpx 0 0;
}

.media {
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-horizontal .media {
  flex: 1;
  min-height: 0;
}

.card-vertical .media {
  width: 140rpx;
  height: 100%;
  flex-shrink: 0;
}

.icon {
  width: 120rpx;
  height: 120rpx;
}

.card-vertical .icon {
  width: 88rpx;
  height: 88rpx;
}

.info {
  padding: 24rpx 28rpx 28rpx;
}

.card-vertical .info {
  flex: 1;
  min-width: 0;
  padding: 20rpx 24rpx 20rpx 8rpx;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #1a1a1a;
}

.desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.4;
}

.count {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  color: #666;
}

.theme-out {
  border: 2rpx solid #d9f3e4;
}

.theme-out .media {
  background: linear-gradient(180deg, #d9f3e4 0%, #f3fbf6 100%);
}

.theme-out .title {
  color: #07c160;
}

.theme-out .count {
  background: #e8f8ef;
  color: #07c160;
}

.theme-home {
  border: 2rpx solid #ffe6cc;
}

.theme-home .media {
  background: linear-gradient(180deg, #ffe6cc 0%, #fff8f0 100%);
}

.theme-home .title {
  color: #ff8f1f;
}

.theme-home .count {
  background: #fff3e8;
  color: #ff8f1f;
}

.theme-fun {
  border: 2rpx solid #e4e7ff;
}

.theme-fun .media {
  background: linear-gradient(180deg, #e4e7ff 0%, #f6f7ff 100%);
}

.theme-fun .title {
  color: #5b6cff;
}

.theme-fun .count {
  background: #eef0ff;
  color: #5b6cff;
}

.dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  padding-top: 20rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ddd;
}

.dot.on {
  width: 24rpx;
  border-radius: 8rpx;
  background: #bbb;
}
