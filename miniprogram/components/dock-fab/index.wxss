.dock-fab {
  position: fixed;
  z-index: 50;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(91, 108, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.dock-fab.snap {
  transition: left 0.2s ease-out, top 0.2s ease-out;
}

.dock-fab.dragging {
  opacity: 0.92;
  transform: scale(1.04);
}

.dock-fab-plus {
  font-size: 77rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}
