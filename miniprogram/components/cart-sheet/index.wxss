.cart-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 60;
}

.cart-sheet {
  position: fixed;
  left: 0;
  right: 0;
  /* 贴在页内底栏上方，不盖住栏；高度与 app-tab-bar placeholder 对齐 */
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  z-index: 70;
  max-height: 72vh;
  min-height: 360rpx;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 0 28rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.cart-sheet[hidden],
.cart-mask[hidden] {
  display: none !important;
}

.cart-sheet__grab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 48rpx 8rpx;
  margin: 0 -12rpx;
  flex-shrink: 0;
  box-sizing: border-box;
}

.cart-sheet__handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #d8d8d8;
  flex-shrink: 0;
}

.cart-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.cart-sheet__title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.cart-sheet__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.share-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #e8f8ef;
  color: #07c160;
  flex-shrink: 0;
}

.preorder-bar {
  white-space: nowrap;
  margin-bottom: 12rpx;
  width: 100%;
}

.preorder-chip {
  display: inline-block;
  padding: 10rpx 20rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 22rpx;
  border: 1rpx solid #eee;
}

.preorder-chip.on {
  background: #e8f8ef;
  color: #07c160;
  border-color: #b7eb8f;
  font-weight: 600;
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 12rpx;
  font-size: 26rpx;
}

.date-label {
  color: #999;
}

.date-value {
  color: #1a1a1a;
  font-weight: 500;
}

.cart-sheet__actions {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.cart-link {
  font-size: 26rpx;
  color: #666;
}

.cart-sheet__list {
  flex: 1;
  max-height: 42vh;
  min-height: 120rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.cart-item__main {
  flex: 1;
  min-width: 0;
}

.cart-item__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.cart-item__del {
  font-size: 26rpx;
  color: #fa5151;
  padding: 12rpx;
  flex-shrink: 0;
}

.cart-empty {
  text-align: center;
  padding: 48rpx 24rpx 32rpx;
  color: #666;
  font-size: 28rpx;
}

.cart-empty__btn {
  margin-top: 28rpx;
  width: 60%;
}

.cart-sheet__foot {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 8rpx;
}

.cart-foot-row {
  display: flex;
  gap: 12rpx;
  width: 100%;
}

.cart-foot-btn {
  flex: 1;
  margin: 0 !important;
  font-size: 26rpx !important;
  padding: 16rpx 8rpx !important;
  line-height: 1.3 !important;
}

.cart-foot-btn--main {
  flex: 1.2;
}

.cart-foot-btn--danger {
  color: #fa5151 !important;
  border-color: #fa5151 !important;
}
