<view class="page-form">
<scroll-view class="page-form-scroll" scroll-y>
  <view class="card">
    <view class="form-item">
      <view class="form-label">片名 *</view>
      <view class="form-field">
        <input
          class="form-input"
          value="{{title}}"
          bindinput="onTitle"
          placeholder="如：沙丘 2"
          maxlength="80"
        />
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">状态</view>
      <view class="chip-row">
        <view
          class="chip {{status === item.id ? 'active' : ''}}"
          wx:for="{{statusOptions}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPickStatus"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">日期</view>
      <picker
        mode="multiSelector"
        range="{{dateRange}}"
        value="{{dateIndex}}"
        bindchange="onDatePick"
        bindcolumnchange="onDateColumn"
      >
        <view class="form-field form-field--tap">
          <text class="{{dateText ? '' : 'form-ph'}}">{{dateText || '选日期（可选）'}}</text>
          <text class="form-caret">›</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <view class="form-label">{{cinemaMulti ? '候选影院（可多选）' : '最终去的影院'}}</view>
      <view class="chip-row" wx:if="{{cinemas.length}}">
        <view
          class="chip {{item.on ? 'active' : ''}}"
          wx:for="{{cinemas}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPickCinema"
        >{{item.name}}</view>
      </view>
      <view class="form-tip" wx:else>还没有影院，可先去「影院」页添加</view>
      <view class="form-tip" wx:if="{{cinemas.length}}">{{cinemaMulti ? '计划阶段可勾几家可能去的影院' : '看完后只选实际去的那一家'}}</view>
    </view>

    <view class="form-item" wx:if="{{halls.length}}">
      <view class="form-label">{{cinemaMulti ? '厅（可选）' : '最终去的厅'}}</view>
      <view class="chip-row">
        <view
          class="chip {{hallId === item.id ? 'active' : ''}}"
          wx:for="{{halls}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onPickHall"
        >{{item.name}}</view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">备注</view>
      <textarea
        class="form-textarea"
        value="{{note}}"
        bindinput="onNote"
        placeholder="谁一起、几点、哪场次"
        maxlength="1000"
        auto-height
      />
    </view>

    <view class="form-item">
      <view class="form-label">截图</view>
      <view class="img-row">
        <view class="img-item" wx:for="{{images}}" wx:key="localPath">
          <image
            class="img"
            src="{{item.localPath}}"
            mode="aspectFill"
            data-index="{{index}}"
            bindtap="onPreviewShot"
          />
          <view class="img-del" data-index="{{index}}" catchtap="onRemoveShot">×</view>
        </view>
        <view class="img-add" bindtap="onAddShot" wx:if="{{images.length < 6}}">+</view>
      </view>
      <view class="form-tip">从相册导入购票/场次截图</view>
    </view>
  </view>
  <button class="btn-ghost btn-block" bindtap="goWriteLog">
    {{linkedLogId ? '打开观影记录' : '看完了，写观影记录'}}
  </button>
  <button class="btn-danger btn-block" wx:if="{{id}}" bindtap="onDelete">删除</button>
</scroll-view>

<view class="watch-dock">
  <view class="watch-dock-btn" bindtap="onSave">保存</view>
</view>
</view>
