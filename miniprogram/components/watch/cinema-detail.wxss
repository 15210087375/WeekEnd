.page-form { height: 100%; display: flex; flex-direction: column; }
.page-form-scroll { flex: 1; height: 0; min-height: 0; padding: 24rpx; box-sizing: border-box; }
.watch-dock { flex-shrink: 0; padding: 16rpx 24rpx; background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,.06); }
.watch-dock-btn { background: #07c160; color: #fff; border-radius: 12rpx; font-size: 28rpx; padding: 20rpx 28rpx; text-align: center; }

.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f7f7f7;
  box-sizing: border-box;
}

.head {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section {
  font-size: 24rpx;
  color: #888;
  margin: 8rpx 8rpx 16rpx;
}

.hall {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.hall:active,
.head:active {
  background: #fafafa;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.hall-thumb {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.hall-name {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}

.link {
  color: #5b6cff;
  font-size: 24rpx;
}

.row-tag {
  font-size: 22rpx;
  color: #07c160;
  background: #e8f8ef;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.muted {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

.empty {
  text-align: center;
  color: #999;
  padding: 80rpx 40rpx;
  font-size: 28rpx;
}
