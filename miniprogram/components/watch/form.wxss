.page-form {
  height: 100%;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #f7f7f7;
}

.page-form-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-field {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 22rpx 20rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.form-input {
  flex: 1;
  width: 100%;
  height: 44rpx;
  min-height: 44rpx;
  line-height: 44rpx;
  font-size: 28rpx;
  color: #191919;
  background: transparent;
  padding: 0;
}

.form-field--tap {
  justify-content: space-between;
}

.form-ph {
  color: #bbb;
}

.form-caret {
  color: #c8c8c8;
  font-size: 32rpx;
  line-height: 1;
  padding-left: 12rpx;
  flex-shrink: 0;
}

.form-textarea {
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  min-height: 140rpx;
  width: 100%;
  color: #191919;
  box-sizing: border-box;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f0f0f0;
  color: #666;
  font-size: 24rpx;
}

.chip.active {
  background: #eef0ff;
  color: #5b6cff;
}

.img-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.img-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.img-del {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.img-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
  border: 2rpx dashed #ccc;
  color: #999;
  font-size: 56rpx;
  line-height: 160rpx;
  text-align: center;
}

.form-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

.muted {
  color: #888;
  font-size: 24rpx;
}

.from-plan {
  font-size: 22rpx;
  color: #5b6cff;
  background: #eef0ff;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
  margin-bottom: 24rpx;
}

.btn-ghost {
  background: #fff;
  color: #07c160;
  border: 1rpx solid #07c160;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 14rpx 24rpx;
  line-height: 1.4;
  margin-top: 8rpx;
}

.btn-danger {
  background: #fff;
  color: #fa5151;
  border: 1rpx solid #fa5151;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 14rpx 24rpx;
  line-height: 1.4;
}

.btn-block {
  width: 100%;
  text-align: center;
  margin-top: 16rpx;
}

.watch-dock {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.watch-dock-btn {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 20rpx 28rpx;
  text-align: center;
}

.watch-dock-btn:active {
  opacity: 0.88;
}
