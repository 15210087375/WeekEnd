.page-stack {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #f7f7f7;
  overflow: hidden;
}

.page-stack-head {
  flex-shrink: 0;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

.page-stack-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 0 24rpx 24rpx;
  box-sizing: border-box;
}

.watch-dock {
  flex-shrink: 0;
  position: relative;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.watch-dock-btn {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 20rpx 28rpx;
  text-align: center;
  line-height: 1.4;
}

.watch-dock-btn:active {
  opacity: 0.85;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 12rpx;
}

.tab.active {
  background: #eef0ff;
  color: #5b6cff;
  font-weight: 600;
}

.filter-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
  width: 100%;
}

.filter-chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #fff;
  color: #666;
  font-size: 24rpx;
  border: 1rpx solid #eee;
}

.filter-chip.active {
  background: #eef0ff;
  color: #5b6cff;
  border-color: #cfd4ff;
  font-weight: 600;
}

.item {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.item:active {
  background: #fafafa;
}

.thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.body {
  flex: 1;
  min-width: 0;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  flex: 1;
}

.count {
  font-size: 22rpx;
  color: #5b6cff;
  background: #eef0ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #f0f0f0;
  color: #666;
}

.status-want {
  background: #eef0ff;
  color: #5b6cff;
}

.status-planned {
  background: #fff3e8;
  color: #ff8f1f;
}

.status-watched {
  background: #e8f8ef;
  color: #07c160;
}

.status-drop {
  background: #f5f5f5;
  color: #999;
}

.muted {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.time {
  -webkit-line-clamp: 1;
}

.item--open {
  display: block;
}

.item--open:active {
  background: #fff;
}

.open-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.open-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
}

.open-edit {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 0 4rpx 12rpx;
}

.open-status {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.st-chip {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #888;
  background: #f4f4f5;
  border: 1rpx solid #eee;
}

.st-chip.on {
  font-weight: 600;
}

.st-chip.on.status-want {
  background: #eef0ff;
  color: #5b6cff;
  border-color: #cfd4ff;
}

.st-chip.on.status-planned {
  background: #fff3e8;
  color: #ff8f1f;
  border-color: #ffd8b0;
}

.st-chip.on.status-watched {
  background: #e8f8ef;
  color: #07c160;
  border-color: #b7eb8f;
}

.st-chip.on.status-drop {
  background: #f0f0f0;
  color: #888;
  border-color: #ddd;
}

.star-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.star-label {
  width: 80rpx;
  font-size: 24rpx;
  color: #888;
  flex-shrink: 0;
}

.open-note {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.7;
  white-space: pre-wrap;
}

.open-imgs {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.open-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.open-link {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #5b6cff;
}

.hall-list {
  margin-top: 16rpx;
}

.hall-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid #f2f2f2;
}

.hall-name {
  font-size: 28rpx;
  color: #333;
}

.hall-row-tag {
  font-size: 22rpx;
  color: #888;
}

.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 40rpx;
  font-size: 28rpx;
  line-height: 1.7;
}
